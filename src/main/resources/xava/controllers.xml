<?xml version = "1.0" encoding = "ISO-8859-1"?>

<!DOCTYPE controllers SYSTEM "dtds/controllers.dtd">

<!-- 
Controllers doc: 
https://www.openxava.org/OpenXavaDoc/docs/controllers_en.html

Default controllers included in OpenXava (you can extend from them):
https://github.com/openxava/openxava/blob/master/openxava/src/main/resources/xava/default-controllers.xml
 
Examples of controllers (from test application):
https://github.com/openxava/openxava/blob/master/openxavatest/src/main/resources/xava/controllers.xml
-->

<controllers>
    
    <!-- Environment variable:
    <env-var name="ProgramaRepuestosDeMotos_DEFAULT_YEAR" value="2015"/> 
    -->
    
    <!-- Session object:
    <object name="ProgramaRepuestosDeMotos_activeYear" class="java.lang.Integer" value="2015" 
    	    scope="global"/>    
    -->
    
    <!-- Controller:
    <controller name="Teacher">
    	<extends controller="Typical"/>
    	<action name="new" icon="plus-box-multiple" keystroke="Control N"
        	class="actions.CreateTeacher">
    	</action>
	</controller>    
    -->
    <controller name="SignIn">
        <action name="init" on-init="true" hidden="true"
                class="com.openxava.naviox.actions.InitSignInAction"/>
        <action name="signIn"
                class="org.example.ProgramaRepuestosDeMotos.actions.SignInAction"/>
    </controller>

    <controller name="Factura">
        <extends controller="Typical"/>
        <action name="agregarGarantia"
                class="org.example.ProgramaRepuestosDeMotos.actions.InsertarGarantiaAction"
                mode="detail"
                icon="gavel"
                label="Agregar Garantía"/>
    </controller>
    
    <controller name="Producto">
        <extends controller="Typical"/>
        <action name="descontinuar"
                class="org.example.ProgramaRepuestosDeMotos.actions.DescontinuarProductoAction"
                mode="list"
                icon="close-octagon-outline"
                confirm="true"
                label="Descontinuar Selección"/>
    </controller>

    <controller name="ControladorRentabilidad">
        <extends controller="Navigation"/>
        <extends controller="Print"/>
        <action name="init"
                class="org.example.ProgramaRepuestosDeMotos.actions.BloquearEdicionAction"
                on-init="true"
                hidden="true"/>
    </controller>


</controllers>
